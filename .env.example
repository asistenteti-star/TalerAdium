# URL del despliegue del Apps Script del Google Sheet (termina en /exec).
# Se obtiene en: Apps Script → Implementar → Nueva implementación → Aplicación web.
SHEETS_WEBHOOK_URL=

# Cadena compartida que el Apps Script compara antes de escribir la fila.
# Genera una al azar, por ejemplo: openssl rand -hex 24
SHEETS_WEBHOOK_TOKEN=
